  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneManager
  introDialogues:
  - "\uC77C\uC5B4\uB0AC\uB098. \uB124 \uBC88\uD638\uB294... 94\uD638\uAD70."
  - "\uBC18\uAC11\uB124. \uB098\uB294 5\uD638\uB2E4. \uB108\uC758 \uC0AC\uC218...
